DATABASE_URL=
REDIS_URL=

SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

UPLOAD_DIR=./uploads

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LLM provider for the domain-fit filter on curriculum recommendations.
# "openai" (default, active) uses OPENAI_API_KEY; "anthropic" uses ANTHROPIC_API_KEY.
LLM_PROVIDER=openai
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

NEXT_PUBLIC_API_URL=

# Comma-separated list of allowed CORS origins for the FastAPI backend.
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
